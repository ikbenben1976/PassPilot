# Server
PORT=5001
CORS_ORIGIN=http://localhost:5173

# Authentication
JWT_SECRET=change-this-to-a-random-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Frontier Data Pipeline
# The booking engine URL (Navitaire). This is what the community tools use.
FRONTIER_BOOKING_URL=https://booking.flyfrontier.com
# Minimum delay between requests in ms (be respectful — 1500ms+ recommended)
FRONTIER_REQUEST_INTERVAL_MS=1500
# Set to 'true' to use mock data, 'false' for live, unset for auto-detect
FRONTIER_USE_MOCK=true

# Database
DATABASE_PATH=./data/passpilot.db
